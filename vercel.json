{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Service-Worker-Allowed", "value": "/" }]
    }
  ],
  "rewrites": [
    { "source": "/v1/(.*)", "destination": "https://story-api.dicoding.dev/v1/$1" },

    { "source": "/(.*\\.(?:js|css|png|jpg|jpeg|svg|webp|gif|ico|json|txt|map))", "destination": "/$1" },
    { "source": "/(icons/.*)", "destination": "/$1" },
    { "source": "/(images/.*)", "destination": "/$1" },
    { "source": "/(assets/.*)", "destination": "/$1" },

    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
